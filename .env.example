# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# tmux Session Configuration
# Name of the tmux session where Claude Code is running
TMUX_SESSION=claude

# SYSTEM_TMUX - Path to tmux binary (optional)
# Override if tmux is not in standard PATH
# Default: 'tmux' (uses PATH)
# SYSTEM_TMUX=

# Bridge Server Configuration
# Port for the webhook bridge server
PORT=8080

# Deployment Mode Configuration (REQUIRED)
# You MUST set this explicitly - there is no default value.
# Options:
#   - tunnel: Local development with Cloudflare Tunnel (no public IP needed)
#   - production: Public deployment with Caddy reverse proxy (requires WEBHOOK_DOMAIN)
# Example: DEPLOYMENT_MODE=tunnel
DEPLOYMENT_MODE=

# Caddy Port Mapping (only used in DEPLOYMENT_MODE=production)
# External ports for Caddy reverse proxy (must be >= 1024 for rootless Docker)
# Defaults: 8081 for HTTP, 8443 for HTTPS (8081 avoids conflict with bridge PORT=8080)
# For rootful Docker with public IP, you can use 80 and 443
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443

# Webhook Path Configuration
# Random path for webhook endpoint to prevent unauthorized access
# A random 64-character hex string is generated if not set
# Set your own custom path if needed (e.g., WEBHOOK_PATH=my_custom_secret_path)
WEBHOOK_PATH=

# Webhook Secret Token Configuration (Optional but Recommended)
# Secret token to validate requests are from Telegram
# When setting webhook in Telegram, add: ?secret_token=<YOUR_SECRET>
# Example: curl "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook?url=https://YOUR-URL/<WEBHOOK_PATH>&secret_token=${TELEGRAM_WEBHOOK_SECRET}"
# Generate a secure random token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Webhook Domain Configuration
# Default domain for the set-webhook command
# Override with --domain flag when running set-webhook command
WEBHOOK_DOMAIN=coder.luandro.com

# Webhook Auto-Setup Configuration
# Enable/disable automatic webhook configuration on container startup
# Set to "false", "0", or "no" to disable auto-setup
WEBHOOK_AUTO_SETUP=true

# Startup delay in seconds to wait for dependent services before webhook setup
# Allows time for cloudflared tunnel or Caddy to initialize
# Default: 5 seconds
WEBHOOK_STARTUP_DELAY=5

# Access Control Configuration
# Get your user ID from @userinfobot on Telegram

# DM (Private Message) Access Control
# Single user ID allowed to send DM updates (private messages)
# If empty or not set, DM updates are not allowed from anyone
DM_ALLOWED_USER_ID=

# Group/Channel Access Control
# Comma-separated list of allowed Telegram user IDs for groups/channels
# Example: 123456789,987654321
# If empty, all users can use the bot in groups/channels (not recommended for production)
ALLOWED_TELEGRAM_USER_IDS=

# Reaction Emoji Configuration
# Emoji to react to user messages (set to "none", "false", "0", or empty to disable)
# Default is thumbs up emoji ()
# Example values: , , ,
TELEGRAM_REACTION_EMOJI=
